# Sentry (Step 15.11)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================
# Google OAuth (Step 16 / Appendix C — Google Sign-in)
# ============================================================
# Obtain from Google Cloud Console (https://console.cloud.google.com)
# Create OAuth 2.0 Client ID (Web Application type).
# Authorized redirect URIs:
#   Local:    http://localhost:4000/api/v1/auth/google/callback
#   Staging:  https://api.nolimitshopping.com/api/v1/auth/google/callback
#   Prod:     https://api.nolimitshopping.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"