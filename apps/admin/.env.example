# Admin app — API endpoint
# Production: leave blank to use same-origin (admin.domain.com → api via cookie)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Sentry (Step 15.11)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05


# Step-88: storefront URL for ISR revalidation calls from admin
NEXT_PUBLIC_STOREFRONT_URL=https://nolimitshopping.com
# Shared secret matching storefront REVALIDATE_SECRET (leave empty in dev)
NEXT_PUBLIC_REVALIDATE_SECRET=